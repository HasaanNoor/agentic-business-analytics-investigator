# Copy this file to .env for local development if needed.
# Do not commit real credentials.

# Local-only Docker Compose defaults. Change these for any shared or deployed environment.
APP_ENV=development
POSTGRES_DB=analytics_local
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=analytics_password
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+psycopg2://analytics_user:analytics_password@db:5432/analytics_local

# Local Compose keeps startup convenient by running migrations and syncing generated outputs.
# Production API replicas should use:
# RUN_MIGRATIONS_ON_STARTUP=false
# SYNC_OUTPUTS_ON_STARTUP=false
# and run `docker compose run --rm api migrate` plus `docker compose run --rm api sync`
# as separate one-off release or initialization tasks.
RUN_MIGRATIONS_ON_STARTUP=true
SYNC_OUTPUTS_ON_STARTUP=true

# API_PORT controls the host port published by local Docker Compose.
# The backend container listens on port 8000 in Compose so nginx can proxy /api requests.
# For API-only container runs outside this Compose file, API_PORT controls the Uvicorn listen port.

# Optional LLM investigation settings. Defaults keep the project deterministic.
LLM_ENABLED=false
AGENT_MODE=deterministic
LLM_FALLBACK_ENABLED=true
OPENAI_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARACTERS=24000
# LLM_TEMPERATURE is optional and ignored for models that do not support it.
# LLM_TEMPERATURE=0.2
